<Project Sdk="Microsoft.NET.Sdk">
  <!-- MessagesServer.exe (SWITCHBOARD.md stage 3): the process that hosts the backends when the window is not the one doing it. It draws
       nothing, so it is a WinExe, and it carries no WinUI and no Windows App SDK (a harness check fails if this project ever names them);
       what only Windows can do arrives through NativeBeeper.Windows. Everything a person can see of it says "Messages Server": the program,
       its window class, its mutex, its log. Code, namespaces and the project keep NativeBeeper. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>MessagesServer</AssemblyName>
    <RootNamespace>NativeBeeper.Server</RootNamespace>
    <Product>Messages Server</Product>
    <AssemblyTitle>Messages Server</AssemblyTitle>
    <Description>Messages Server</Description>
    <Company>wrenchware</Company>
    <!-- Compiled ahead of time on publish, for two reasons. The app's NativeBeeper.*.dll are, and the installer's build refuses two publishes
         that make a file of the same name with different contents. And the start then runs code instead of compiling it first (SWITCHBOARD.md
         3.1d): server started to server listening, warm 141 to 118 ms and first start on new files 413-422 to 239-250 ms, then 59 and 181 with
         ServerWarmUp, for 8 MB more on disk. Development builds are unchanged. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Selects the WinRT form of the browser the Google renewal loads (NativeBeeper.Windows.Browser): the same projection and native
         Microsoft.Web.WebView2.Core.dll the app publishes. The App SDK sets this for the app by itself; the server has none (3.1c spike). -->
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
    <!-- The app refuses a server whose version is not its own, so this is read from the app's project at build time: tools\Release.ps1 edits
         only that one line, and a copy here would fall behind it (a harness check compares the two). -->
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../NativeBeeper.App/NativeBeeper.App.csproj')), '(?s)^.*?&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;.*$', '$1'))</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <ProjectReference Include="../NativeBeeper.Core/NativeBeeper.Core.csproj" />
    <ProjectReference Include="../NativeBeeper.Protocol/NativeBeeper.Protocol.csproj" />
    <ProjectReference Include="../NativeBeeper.Backends/NativeBeeper.Backends.csproj" />
    <ProjectReference Include="../NativeBeeper.Presentation/NativeBeeper.Presentation.csproj" />
    <ProjectReference Include="../NativeBeeper.Storage/NativeBeeper.Storage.csproj" />
    <ProjectReference Include="../NativeBeeper.Host/NativeBeeper.Host.csproj" />
    <!-- The network door, its page, pushes and pairing (SWITCHBOARD.md 10.7): the Linux host's, on 127.0.0.1 and the tailnet. It brings ASP.NET Core into this
         program only; the app never references it (ProtocolNetworkChecks). -->
    <ProjectReference Include="../NativeBeeper.Host.Network/NativeBeeper.Host.Network.csproj" />
    <ProjectReference Include="../NativeBeeper.Windows/NativeBeeper.Windows.csproj" />
    <ProjectReference Include="../NativeBeeper.Windows.Browser/NativeBeeper.Windows.Browser.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- No WinUI types, so the harness links this file as well. -->
    <Compile Include="../NativeBeeper.App/Services/RunMarker.cs" Link="RunMarker.cs" />
    <!-- The tailnet door's supervisor, the Linux host's own (plain C#, its namespace kept): the same arguments, line routing and restarts on Windows. -->
    <Compile Include="../NativeBeeper.Server.Linux/TailnetDoor.cs" Link="TailnetDoor.cs" />
  </ItemGroup>
  <!-- The providers' helpers are found beside the program, as they are beside the app's (HelperConnection). -->
  <ItemGroup>
    <Content Include="../../experiments/GoogleMessages/helper/bin/gmessages-helper.exe" Link="gmessages-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../experiments/GoogleMessages/helper/bin/gmessages-helper.exe')" />
    <Content Include="../../experiments/Messenger/helper/bin/messenger-helper.exe" Link="messenger-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../experiments/Messenger/helper/bin/messenger-helper.exe')" />
    <Content Include="../../experiments/GoogleVoice/helper/bin/gvoice-helper.exe" Link="gvoice-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../experiments/GoogleVoice/helper/bin/gvoice-helper.exe')" />
    <Content Include="../../experiments/Instagram/helper/bin/instagram-helper.exe" Link="instagram-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../experiments/Instagram/helper/bin/instagram-helper.exe')" />
    <!-- The server's own door on the owner's tailnet (SWITCHBOARD.md 10.7), built by experiments\Tailnet\Build.ps1; its modules' licences are in THIRD_PARTY_NOTICES.md. -->
    <Content Include="../../experiments/Tailnet/door/bin/windows-amd64/messages-tailnet.exe" Link="messages-tailnet.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../experiments/Tailnet/door/bin/windows-amd64/messages-tailnet.exe')" />
  </ItemGroup>
</Project>
