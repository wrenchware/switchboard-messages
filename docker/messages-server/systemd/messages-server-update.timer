# Each night at about 03:00 (the hour Unraid's Auto Update Applications pulls the image), Messages Server takes the
# newest release when /etc/messages-server/update names one, and the newest stable Chrome when Google is on. A night the
# machine was off is made up at the next boot.
[Unit]
Description=Nightly Messages Server update

[Timer]
OnCalendar=*-*-* 03:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
