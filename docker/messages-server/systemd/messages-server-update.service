# The nightly update of Messages Server installed by install.sh (messages-server-update.timer starts it). update.sh does
# nothing unless /etc/messages-server/update names a release address, and with Google on it also takes the newest
# stable Google Chrome. Run it by hand with: systemctl start messages-server-update
[Unit]
Description=Messages Server update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/messages-server/update.sh
# A download, a check and the server's own stop (up to 60 s) and start.
TimeoutStartSec=30min
