<Project>
  <!-- Security floor for the .NET runtime a self-contained publish carries (Messages.exe, the Windows server, the Google
       server image). Windows Update never patches a runtime that ships inside an app, so it is as new as the SDK that
       built it, and global.json's SDK can lag the monthly security release. While the SDK bundles an older runtime than
       the floor, the publish takes the floor's runtime packs from NuGet; once the SDK catches up this does nothing.
       Raise the floor with each .NET security release (https://dotnet.microsoft.com/download/dotnet/10.0). It sits in a
       .targets file because the SDK's KnownFrameworkReference items exist only after the project's props. -->
  <ItemGroup Condition="'$(SelfContained)' == 'true' and $([MSBuild]::VersionLessThan('$(BundledNETCoreAppPackageVersion)', '10.0.13'))">
    <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.AspNetCore.App" LatestRuntimeFrameworkVersion="10.0.13" />
  </ItemGroup>
</Project>
