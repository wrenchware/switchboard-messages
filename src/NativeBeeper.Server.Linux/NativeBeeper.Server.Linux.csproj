<Project Sdk="Microsoft.NET.Sdk">
  <!-- messages-server (SWITCHBOARD.md stage 4): the backends hosted on Linux, as a console service. Plain net10.0 with no Windows
       reference of any kind (a harness check fails if it names one), so what only Windows can do is either replaced here (the key file
       protector, the snooze store) or refused (the providers this host does not run). The runtime is given by the publish (-r linux-x64,
       self-contained), after a locked restore of this project with no runtime given, and with the publish's own restore turned off: a
       restore given -r writes that runtime into every referenced library's lock file. The list below is what lets this project's own
       locked restore cover the Linux runtimes. The runtime needs libicu on the host (or DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1).
       Everything a person can see says "Messages Server"; code and namespaces keep NativeBeeper. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <AssemblyName>messages-server</AssemblyName>
    <RootNamespace>NativeBeeper.Server.Linux</RootNamespace>
    <Product>Messages Server</Product>
    <AssemblyTitle>Messages Server</AssemblyTitle>
    <Description>Messages Server</Description>
    <Company>wrenchware</Company>
    <!-- One version for the app and every host (SWITCHBOARD.md decisions), read from the app's project as the Windows server reads it. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../NativeBeeper.App/NativeBeeper.App.csproj')), '(?s)^.*?&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;.*$', '$1'))</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Google Voice's photo re-encoder (SkiaPhotoReencoder; SWITCHBOARD.md 4.4). MIT, with Skia's own codecs inside the native library. The
         NoDependencies build links its few libraries in statically, so it loads on the runtime image (glibc only) without fontconfig or anything
         installed beside it. SkiaSharp also brings its Windows and macOS natives; they are excluded, as this program never runs there and a
         build on Windows would otherwise copy about 400 MB of them (with their symbols) into bin. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" ExcludeAssets="all" />
    <ProjectReference Include="../NativeBeeper.Core/NativeBeeper.Core.csproj" />
    <ProjectReference Include="../NativeBeeper.Protocol/NativeBeeper.Protocol.csproj" />
    <ProjectReference Include="../NativeBeeper.Backends/NativeBeeper.Backends.csproj" />
    <ProjectReference Include="../NativeBeeper.Presentation/NativeBeeper.Presentation.csproj" />
    <ProjectReference Include="../NativeBeeper.Storage/NativeBeeper.Storage.csproj" />
    <ProjectReference Include="../NativeBeeper.Host/NativeBeeper.Host.csproj" />
    <ProjectReference Include="../NativeBeeper.Host.Network/NativeBeeper.Host.Network.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plain C# shared with the Windows server: the run marker and the gated provider feed. -->
    <Compile Include="../NativeBeeper.App/Services/RunMarker.cs" Link="RunMarker.cs" />
    <Compile Include="../NativeBeeper.Server/ServerPorts.cs" Link="ServerPorts.cs" />
  </ItemGroup>
  <!-- The helpers this host runs, found beside the program (HelperExecutables), built by experiments\Messenger\Build-Linux.ps1,
       experiments\Instagram\Build-Linux.ps1 and, for Google Messages (run only with MESSAGES_GOOGLE=1), experiments\GoogleMessages\Build-Linux.ps1. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="../../experiments/Messenger/helper/bin/linux-amd64/messenger-helper" Link="messenger-helper" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../experiments/Messenger/helper/bin/linux-amd64/messenger-helper')" />
    <Content Include="../../experiments/Instagram/helper/bin/linux-amd64/instagram-helper" Link="instagram-helper" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../experiments/Instagram/helper/bin/linux-amd64/instagram-helper')" />
    <Content Include="../../experiments/GoogleMessages/helper/bin/linux-amd64/gmessages-helper" Link="gmessages-helper" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../experiments/GoogleMessages/helper/bin/linux-amd64/gmessages-helper')" />
  </ItemGroup>
</Project>
