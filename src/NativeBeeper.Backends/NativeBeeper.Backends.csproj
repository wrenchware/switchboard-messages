<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that talks to Google Messages, Messenger, Google Voice and Instagram: the providers, their routers and
       the helper transport. Plain net10.0 with no Windows API outside OperatingSystem.IsWindows() guards, so a server can
       host it (SWITCHBOARD.md). Namespaces are the ones they had inside the app, and the app and harness see its internals. -->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Messages" />
    <InternalsVisibleTo Include="MessagesServer" />
    <InternalsVisibleTo Include="messages-server" />
    <InternalsVisibleTo Include="NativeBeeper.ContractTests" />
    <InternalsVisibleTo Include="NativeBeeper.Host" />
    <InternalsVisibleTo Include="NativeBeeper.Windows.Browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <ProjectReference Include="../NativeBeeper.Core/NativeBeeper.Core.csproj" />
    <ProjectReference Include="../NativeBeeper.Presentation/NativeBeeper.Presentation.csproj" />
    <ProjectReference Include="../NativeBeeper.Storage/NativeBeeper.Storage.csproj" />
  </ItemGroup>
  <!-- The helper transport stays in experiments/, where the spikes link the same files. -->
  <ItemGroup>
    <Compile Include="../../experiments/GoogleMessages/NativeBeeper.GoogleMessages.Spike/HelperConnection.cs" Link="Services/GoogleMessages/HelperConnection.cs" />
    <Compile Include="../../experiments/GoogleMessages/NativeBeeper.GoogleMessages.Spike/HelperErrorCodes.cs" Link="Services/GoogleMessages/HelperErrorCodes.cs" />
    <Compile Include="../../experiments/GoogleMessages/NativeBeeper.GoogleMessages.Spike/HelperRequests.cs" Link="Services/GoogleMessages/HelperRequests.cs" />
    <Compile Include="../../experiments/GoogleMessages/NativeBeeper.GoogleMessages.Spike/HelperCallGate.cs" Link="Services/GoogleMessages/HelperCallGate.cs" />
    <Compile Include="../../experiments/GoogleMessages/NativeBeeper.GoogleMessages.Spike/HelperJob.cs" Link="Services/GoogleMessages/HelperJob.cs" />
  </ItemGroup>
</Project>
