<Project Sdk="Microsoft.NET.Sdk">
  <!-- What a host owns when it serves the backends over the protocol: the dispatcher's services, the event log, the state
       publisher, the journal and the upload store (SWITCHBOARD.md stage 3). Plain net10.0 with no Windows or WinUI
       reference, so the app's loopback, the local server and a Linux host all call the same ProtocolHost.Create; what only
       Windows can do arrives as a port. -->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Messages" />
    <InternalsVisibleTo Include="MessagesServer" />
    <InternalsVisibleTo Include="NativeBeeper.Host.Network" />
    <InternalsVisibleTo Include="messages-server" />
    <InternalsVisibleTo Include="NativeBeeper.ContractTests" />
    <InternalsVisibleTo Include="messages-sample-server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeBeeper.Core/NativeBeeper.Core.csproj" />
    <ProjectReference Include="../NativeBeeper.Protocol/NativeBeeper.Protocol.csproj" />
    <ProjectReference Include="../NativeBeeper.Backends/NativeBeeper.Backends.csproj" />
    <ProjectReference Include="../NativeBeeper.Presentation/NativeBeeper.Presentation.csproj" />
  </ItemGroup>
</Project>
