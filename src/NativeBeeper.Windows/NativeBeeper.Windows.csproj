<Project Sdk="Microsoft.NET.Sdk">
  <!-- What only Windows can do for the backends' ports: DPAPI, the media player and imaging (SWITCHBOARD.md stage 3). It uses the
       Windows SDK's own WinRT projection and nothing else, so the app and a MessagesServer.exe without the Windows App SDK load
       the same code; a harness check fails if this project ever names the Windows App SDK, WinUI or WebView2. -->
  <!-- The namespace is NativeBeeper.WindowsPlatform, not NativeBeeper.Windows: a NativeBeeper.Windows namespace would make every
       Windows.Foundation or Windows.UI in the app's NativeBeeper.* namespaces resolve to it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeBeeper.Core/NativeBeeper.Core.csproj" />
    <ProjectReference Include="../NativeBeeper.Presentation/NativeBeeper.Presentation.csproj" />
  </ItemGroup>
</Project>
